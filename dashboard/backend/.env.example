# PoultryGuard — Backend Environment Variables Template
# Copy this file to `.env` and fill in your actual values.
# NEVER commit `.env` to Git repository!

# PostgreSQL connection string (system of record)
DATABASE_URL=postgresql://user:password@localhost:5432/poultryguard

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
# Path to Firebase Admin SDK service-account JSON (optional for dev)
FIREBASE_CREDENTIALS_PATH=

# Google Gemini Vision & AI API Key (optional for backend vision diagnosis)
GEMINI_API_KEY=your_gemini_api_key_here

# IoT Device Pre-Shared Key (HMAC verification for ESP32 hardware telemetry)
IOT_DEVICE_SECRET=your_iot_pre_shared_secret_here

# Allowed CORS origins (comma-separated, optional)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Environment (development | production)
ENVIRONMENT=development
