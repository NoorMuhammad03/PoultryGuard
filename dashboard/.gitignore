# Root .gitignore for PoultryGuard

# Environments & Secret Keys — NEVER commit real credentials
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example
*serviceAccountKey*.json
*firebase-adminsdk*.json

# SQLite & Databases
*.db
*.sqlite
*.sqlite3
backend/poultryguard.db

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/
ENV/

# Node.js & Vite Builds
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor & OS Artifacts
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.swo
